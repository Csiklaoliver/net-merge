# Maintainer: Rohit Mahto <rohit@champdev.me>
# Uses the release's prebuilt binary. scripts/aur.sh fills in pkgver and the checksums on each release.
pkgname=net-merge-bin
pkgver=0.0.0
pkgrel=1
pkgdesc='Use all your network adapters at once: Wi-Fi, Ethernet and phone tethers (prebuilt)'
arch=(x86_64 aarch64 armv7h armv6h i686 riscv64 powerpc64le s390x loong64)
url='https://github.com/rohit267/net-merge'
license=(MIT)
depends=(libcap)
provides=(net-merge)
conflicts=(net-merge)
install=net-merge.install
_rel="$url/releases/download/v$pkgver/net-merge-$pkgver-linux"
# the source tree (for the desktop file and icons), then the binary for the CPU
source=("net-merge-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
source_x86_64=("net-merge-$pkgver-linux-x86_64.tar.gz::$_rel-x86_64.tar.gz")
source_aarch64=("net-merge-$pkgver-linux-aarch64.tar.gz::$_rel-aarch64.tar.gz")
source_armv7h=("net-merge-$pkgver-linux-armv7.tar.gz::$_rel-armv7.tar.gz")
source_armv6h=("net-merge-$pkgver-linux-armv6.tar.gz::$_rel-armv6.tar.gz")
source_i686=("net-merge-$pkgver-linux-i686.tar.gz::$_rel-i686.tar.gz")
source_riscv64=("net-merge-$pkgver-linux-riscv64.tar.gz::$_rel-riscv64.tar.gz")
source_powerpc64le=("net-merge-$pkgver-linux-ppc64le.tar.gz::$_rel-ppc64le.tar.gz")
source_s390x=("net-merge-$pkgver-linux-s390x.tar.gz::$_rel-s390x.tar.gz")
source_loong64=("net-merge-$pkgver-linux-loongarch64.tar.gz::$_rel-loongarch64.tar.gz")
sha256sums=(SKIP)
sha256sums_x86_64=(SKIP)
sha256sums_aarch64=(SKIP)
sha256sums_armv7h=(SKIP)
sha256sums_armv6h=(SKIP)
sha256sums_i686=(SKIP)
sha256sums_riscv64=(SKIP)
sha256sums_powerpc64le=(SKIP)
sha256sums_s390x=(SKIP)
sha256sums_loong64=(SKIP)

package() {
  install -Dm755 net-merge "$pkgdir/usr/bin/net-merge"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/net-merge/LICENSE"
  cd "net-merge-$pkgver"
  install -Dm644 packaging/io.github.rohit267.net-merge.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/io.github.rohit267.net-merge.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  install -d "$pkgdir/usr/share/icons"
  cp -r packaging/icons/hicolor "$pkgdir/usr/share/icons/"
}
