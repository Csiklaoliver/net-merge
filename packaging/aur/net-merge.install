# Lets net-merge create its virtual adapter without running as root. File capabilities are
# dropped whenever the binary is replaced, so this runs on every install and upgrade.
post_install() {
    setcap cap_net_admin,cap_net_raw+ep /usr/bin/net-merge ||
        echo "net-merge: setcap failed; run: sudo setcap cap_net_admin,cap_net_raw+ep /usr/bin/net-merge"
}

post_upgrade() {
    post_install
}
